{
  "name": "foodboxd",
  "version": "1.0.0",
  "private": true,
  "description": "Foodboxd — diário de restaurantes (PWA + casca iOS via Capacitor).",
  "scripts": {
    "build:www": "node scripts/build-www.js",
    "sync": "npm run build:www && npx cap sync ios",
    "ios": "npm run sync && npx cap open ios",
    "preview": "node scripts/preview.mjs",
    "emu:start": "firebase emulators:start --only auth,firestore,functions,storage --project app-restaurantes-499400",
    "emu:seed": "node scripts/seed-emulator.js",
    "qa": "firebase hosting:channel:deploy qa-local --expires 30d --project app-restaurantes-499400",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "playwright": "^1.56.1"
  }
}
