{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase/**",
      "functions/**",
      "README.md",
      "CONTEXT.md",
      "CLAUDE.md",
      "DESIGN-BRIEF.md",
      "DESIGN-BRIEF-MARCA.md",
      "DESIGN-HANDOFF.md",
      "design/**",
      "AI_SETUP.md",
      ".git/**",
      ".github/**",
      ".agents/**",
      "**/.*",
      "**/node_modules/**",
      "www/**",
      "ios/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "capacitor.config.json",
      "GoogleService-Info.plist",
      "ios-info.json",
      "SETUP_IOS.md",
      "HANDOFF-IOS-AGENTE.md",
      "ios-signing.json",
      "ios-entitlements.plist",
      "loja/**"
    ],
    "rewrites": [
      {
        "source": "/api/ai",
        "function": "ai",
        "region": "europe-west1"
      },
      {
        "source": "/api/conta",
        "function": "conta",
        "region": "europe-west1"
      },
      {
        "source": "/privacidade",
        "destination": "/privacidade.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(css|js|json|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
