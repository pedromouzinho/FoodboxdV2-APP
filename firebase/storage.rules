rules_version = '2';

// Cloud Storage rules for user-uploaded restaurant photos.
//   restaurants/{restaurantId}/{fileName}
// Anyone can view the photos; only signed-in people can upload (images only,
// max ~6 MB), and a signed-in person can delete files.
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurants/{restaurantId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 6 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
