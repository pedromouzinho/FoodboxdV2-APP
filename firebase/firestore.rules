rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared restaurant list. Anyone can read the map and add a new place,
    // but existing entries cannot be edited or deleted from the browser.
    // (You can still delete anything from the Firebase console.)
    match /restaurants/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
