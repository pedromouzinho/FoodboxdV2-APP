# Firebase CLI local cache (deploy state, not source)
.firebase/
firebase-debug.log
firestore-debug.log

# Node
node_modules/

# Capacitor: build output (generated from web source by scripts/build-www.js)
www/

# macOS
.DS_Store

# Service account keys must never be committed
*serviceaccount*.json
sa.json

# Segredos das funções. A chave da Anthropic vivia só como variável no serviço
# Cloud Run — invisível no repositório e apagada por qualquer deploy de
# functions. Passa a viver aqui, e aqui nunca entra no git.
functions/.env
functions/.env.*
.env

# Capturas do npm run preview (geradas)
.preview/
